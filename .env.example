# BBONG 환경변수 템플릿. 복사해서 .env로 쓰고 값 채움: cp .env.example .env
# .env는 커밋 안 함(.gitignore). 운영은 매니지드 호스팅의 시크릿 매니저로 동일 키 주입.
# 개발: 서버가 시작 시 루트 .env를 로드(DotNetEnv). compose는 POSTGRES_* 를 읽음.

# ── 런타임 환경 ───────────────────────────────────────────────
# Development | Production. 개발/운영 분기의 단일 스위치(ASP.NET Core 표준).
ASPNETCORE_ENVIRONMENT=Development

# ── PostgreSQL (compose가 컨테이너 기동에 사용) ───────────────
POSTGRES_USER=bbong
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bbong

# ── 서버 DB 연결 ──────────────────────────────────────────────
# 개발: 위 compose PG로 접속. 운영: 매니지드 PostgreSQL 접속 문자열.
BBONG_DB_CONN=Host=localhost;Port=5432;Database=bbong;Username=bbong;Password=change_me

# ── Redis (Phase 5 매칭 큐·presence. 지금은 미사용) ───────────
BBONG_REDIS_CONN=localhost:6379

# ── JWT (인증 토큰) ───────────────────────────────────────────
# Key는 32바이트 이상. 운영은 반드시 강한 랜덤값으로 교체.
BBONG_JWT_KEY=dev-only-insecure-signing-key-change-me-32+bytes
# 아래 둘은 선택(미지정 시 코드 기본값 bbong / bbong-client)
# BBONG_JWT_ISSUER=bbong
# BBONG_JWT_AUDIENCE=bbong-client

# ── 소셜 로그인 (Phase 4 후속) ────────────────────────────────
# 개발에서 true면 실제 provider 검증을 건너뛰고 fake 로그인 허용(앱 등록 전 통합 테스트용).
# 운영은 반드시 false.
BBONG_SOCIAL_DEV_BYPASS=true
# Google: Cloud Console OAuth 클라이언트 ID(무료·즉시 발급)
BBONG_GOOGLE_CLIENT_ID=
# Kakao: Kakao Developers REST API 키(무료·즉시 발급)
BBONG_KAKAO_REST_API_KEY=
# Apple: Developer Program 필요($99/년). 출시 시점에 발급.
BBONG_APPLE_CLIENT_ID=
BBONG_APPLE_TEAM_ID=
BBONG_APPLE_KEY_ID=

# ── CORS (웹 빌드 배포 시. 지금은 미사용) ─────────────────────
# 쉼표 구분 허용 오리진. 예: https://bbong.example,http://localhost:3000
BBONG_CORS_ORIGINS=
